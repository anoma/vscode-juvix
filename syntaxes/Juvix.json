{
  "name": "Juvix",
  "scopeName": "source.juvix",
  "fileTypes": ["juvix"],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "--.*$",
          "name": "comment.line.double-dash.juvix"
        },
        {
          "begin": "\\{--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.juvix"
            }
          },
          "end": "--\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.juvix"
            }
          },
          "name": "comment.documentation.block.juvix"
        },
        {
          "begin": "\\{-",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.juvix"
            }
          },
          "end": "-\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.juvix"
            }
          },
          "name": "comment.block.juvix"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "match": "\".*\"",
          "name": "string"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b(\\d+)\\b",
          "name": "number"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(let|in|case|of|type|trait|instance|module|import|open|using|hiding|public|as|terminating|positive|Type|builtin|syntax)\\b",
          "name": "keyword"
        },
        {
          "name": "delimiter",
          "match": "(;)"
        },
        {
          "name": "keyword",
          "match": "(:=|:|\\/|->|→|↦|@|\\|)"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "(\\+|-|\\*|\\^|\\$|&&|\\!|==|>>|<=|>=)",
          "name": "function"
        }
      ]
    }
  }
}
