{
  "scopeName": "text.juvix.markdown",
  "name": "JuvixMarkdown",
  "patterns": [
    {
      "include": "#markdown"
    }
  ],
  "repository": {
    "markdown": {
      "patterns": [
        {
          "begin": "^(`{3,})\\s*(juvix)\\s*$",
          "end": "^\\1\\s*$",
          "name": "fenced_code.block.language-juvix",
          "contentName": "source.juvix",
          "patterns": [
            {
              "include": "#juvix"
            }
          ]
        },
        {
          "include": "text.html.markdown"
        }
      ]
    },
    "juvix": {
      "patterns": [
        {
          "match": "\\b(let|in|data|case|of|module|import|as|where|type)\\b",
          "name": "keyword.control.juvix"
        },
        {
          "match": "\\b(True|False|None)\\b",
          "name": "constant.language.juvix"
        },
        {
          "match": "\\b([0-9]+)\\b",
          "name": "constant.numeric.juvix"
        },
        {
          "match": "\"([^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.juvix"
        },
        {
          "match": "'[^'\\\\]*'",
          "name": "string.quoted.single.juvix"
        },
        {
          "match": "--.*$",
          "name": "comment.line.double-dash.juvix"
        },
        {
          "begin": "\\{--",
          "end": "--\\}",
          "name": "comment.block.juvix"
        },
        {
          "begin": "\\{-",
          "end": "-\\}",
          "name": "comment.block.juvix"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "name": "variable.juvix"
        }
      ]
    }
  }
}
