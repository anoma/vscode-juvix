{
  "name": "juvix-mode",
  "version": "0.2.0",
  "license": "GPL-3.0",
  "description": "Juvix Mode for VSCode",
  "displayName": "Juvix",
  "publisher": "Heliax",
  "icon": "assets/tara.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/anoma/vscode-juvix.git"
  },
  "bugs": {
    "url": "https://github.com/anoma/vscode-juvix/issues"
  },
  "directories": {
    "test": "test"
  },
  "engines": {
    "vscode": "^1.91.1"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "juvix",
    "language",
    "programming"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:Juvix",
    "onLanguage:JuvixAsm",
    "onLanguage:JuvixCore",
    "onLanguage:JuvixMarkdown",
    "onLanguage:JuvixGeb",
    "onCommand:juvix-mode.installJuvixBinary"
  ],
  "extensionPack": [
    "czhang03.unicode-math-input"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "pretest": "npm run compile && npm run compile && npm run lint",
    "pretty": "npx prettier --write .",
    "lint": "eslint src --fix"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "arrowParens": "avoid",
    "semi": true,
    "singleQuote": true,
    "bracketSpacing": true
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.autoDetect": true,
  "contributes": {
    "configurationDefaults": {
      "[Juvix]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.unicodeHighlight.invisibleCharacters": true,
        "editor.trimAutoWhitespace": true
      },
      "editor.tokenColorCustomizations": {
        "[*Light*]": {
          "textMateRules": [
            {
              "scope": "comments",
              "settings": {
                "foreground": "#a8a8a8",
                "fontStyle": "italic"
              }
            },
            {
              "scope": "pragma",
              "settings": {
                "foreground": "#7e7d7d",
                "fontStyle": "italic"
              }
            },
            {
              "scope": "axiom",
              "settings": {
                "foreground": "#ad1313"
              }
            },
            {
              "scope": "constructor",
              "settings": {
                "foreground": "#8d8dff"
              }
            },
            {
              "scope": "error",
              "settings": {
                "foreground": "#bd3744",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "function",
              "settings": {
                "foreground": "#d98200"
              }
            },
            {
              "scope": "type",
              "settings": {
                "foreground": "#769c03"
              }
            },
            {
              "scope": "keyword",
              "settings": {
                "foreground": "#0083e1"
              }
            },
            {
              "scope": "module",
              "settings": {
                "foreground": "#1b1b1b"
              }
            },
            {
              "scope": "number",
              "settings": {
                "foreground": "#a0d500"
              }
            },
            {
              "scope": "string",
              "settings": {
                "foreground": "#ff4d00"
              }
            },
            {
              "scope": "storage",
              "settings": {
                "foreground": "#befc04"
              }
            },
            {
              "scope": "punctuation.definition.group",
              "settings": {
                "foreground": "#FF0000"
              }
            }
          ]
        },
        "[*Dark*]": {
          "textMateRules": [
            {
              "scope": "comments",
              "settings": {
                "foreground": "#646464",
                "fontStyle": "italic"
              }
            },
            {
              "scope": "pragma",
              "settings": {
                "foreground": "#a9a9a9",
                "fontStyle": "italic"
              }
            },
            {
              "scope": "axiom",
              "settings": {
                "foreground": "#f07171"
              }
            },
            {
              "scope": "constructor",
              "settings": {
                "foreground": "#8d8dff"
              }
            },
            {
              "scope": "error",
              "settings": {
                "foreground": "#bd3744",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "function",
              "settings": {
                "foreground": "#feb64a"
              }
            },
            {
              "scope": "type",
              "settings": {
                "foreground": "#86b300"
              }
            },
            {
              "scope": "keyword",
              "settings": {
                "foreground": "#399ee6"
              }
            },
            {
              "scope": "module",
              "settings": {
                "foreground": "#ffffff"
              }
            },
            {
              "scope": "number",
              "settings": {
                "foreground": "#befc04"
              }
            },
            {
              "scope": "string",
              "settings": {
                "foreground": "#ff4d00"
              }
            },
            {
              "scope": "storage",
              "settings": {
                "foreground": "#befc04"
              }
            },
            {
              "scope": "punctuation.definition.group",
              "settings": {
                "foreground": "#FF0000"
              }
            }
          ]
        }
      },
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "[*Light*]": {
          "rules": {
            "axiom": {
              "foreground": "#ad1313"
            },
            "rules": {
              "foreground": "#ef3e9d"
            },
            "comment": {
              "foreground": "#a8a8a8",
              "fontStyle": "italic"
            },
            "pragma": {
              "foreground": "#717070"
            },
            "constructor": {
              "foreground": "#8d8dff"
            },
            "error": {
              "foreground": "#ed1452",
              "fontStyle": "bold"
            },
            "function": {
              "foreground": "#ef9f00"
            },
            "type": {
              "foreground": "#31a36a"
            },
            "keyword": {
              "foreground": "#000bd3"
            },
            "module": {
              "foreground": "#1b1b1b"
            },
            "number": {
              "foreground": "#6b8e00"
            },
            "string": {
              "foreground": "#ff4d00"
            }
          }
        },
        "[*Dark*]": {
          "rules": {
            "axiom": {
              "foreground": "#f07171"
            },
            "rules": {
              "foreground": "#ef3e9d"
            },
            "comment": {
              "foreground": "#a8a8a8",
              "fontStyle": "italic"
            },
            "pragma": {
              "foreground": "#aaa9a9"
            },
            "constructor": {
              "foreground": "#8d8dff"
            },
            "error": {
              "foreground": "#ed1452",
              "fontStyle": "bold"
            },
            "function": {
              "foreground": "#ffc522"
            },
            "type": {
              "foreground": "#3cbc7f"
            },
            "keyword": {
              "foreground": "#45caff"
            },
            "module": {
              "foreground": "#ffffff"
            },
            "number": {
              "foreground": "#befc04"
            },
            "string": {
              "foreground": "#fb6349"
            },
            "storage": {
              "foreground": "#befc04"
            },
            "punctuation.definition.group": {
              "foreground": "#FF0000"
            }
          }
        }
      }
    },
    "languages": [
      {
        "id": "Juvix",
        "extensions": [
          ".juvix"
        ],
        "aliases": [
          "Juvix",
          "juvix"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "JuvixMarkdown",
        "extensions": [
          ".juvix.md"
        ],
        "aliases": [
          "JuvixMarkdown"
        ],
        "configuration": "./language-configuration-juvix-md.json"
      },
      {
        "id": "JuvixAsm",
        "aliases": [
          "JuvixAsm"
        ],
        "extensions": [
          ".jva"
        ]
      },
      {
        "id": "JuvixCore",
        "aliases": [
          "JuvixCore"
        ],
        "extensions": [
          ".jvc"
        ]
      },
      {
        "id": "JuvixGeb",
        "aliases": [
          "JuvixGeb",
          "geb"
        ],
        "extensions": [
          ".geb"
        ],
        "configuration": "./language-configuration-geb.json"
      }
    ],
    "grammars": [
      {
        "language": "Juvix",
        "scopeName": "source.Juvix",
        "path": "./syntaxes/Juvix.json"
      },
      {
        "language": "JuvixMarkdown",
        "scopeName": "text.juvix.markdown",
        "path": "./syntaxes/JuvixMarkdown.json"
      },
      {
        "language": "JuvixCore",
        "scopeName": "source.JuvixCore",
        "path": "./syntaxes/JuvixCore.tmLanguage.json"
      },
      {
        "language": "JuvixGeb",
        "scopeName": "source.JuvixGeb",
        "path": "./syntaxes/JuvixGeb.tmLanguage.json"
      },
      {
        "language": "JuvixAsm",
        "scopeName": "source.JuvixAsm",
        "path": "./syntaxes/JuvixAsm.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [],
    "taskDefinitions": [
      {
        "when": "editorLangId == Juvix || editorLangId == JuvixMarkdown",
        "type": "Juvix",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "juvixerror",
        "owner": "juvixerror",
        "source": "Juvix Error",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "kind": "location",
            "regexp": "^(.+):(\\d+)(?:-(\\d+))?:(\\d+)-(\\d+): (\\w+).*",
            "file": 1,
            "line": 2,
            "endLine": 3,
            "column": 4,
            "endColumn": 5,
            "severity": 6
          },
          {
            "regexp": "(.*)",
            "message": 1,
            "loop": true
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "juvix-mode.installJuvixBinary",
        "title": "Install Juvix Binary",
        "category": "Juvix"
      },
      {
        "command": "juvix-mode.getBinaryVersion",
        "title": "Get Binary Version",
        "category": "Juvix"
      },
      {
        "command": "juvix-mode.doctor",
        "title": "Run Doctor Command",
        "category": "Juvix"
      },
      {
        "command": "juvix-mode.typecheck",
        "title": "Typecheck current file",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus",
        "icon": "$(check)"
      },
      {
        "command": "juvix-mode.typecheck-silent",
        "title": "Silent typecheck current file",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus",
        "icon": "$(check)"
      },
      {
        "command": "juvix-mode.compile",
        "title": "Compile current file",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus",
        "icon": "$(output)"
      },
      {
        "command": "juvix-mode.run",
        "title": "Evaluate current file",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus",
        "icon": "$(debug-start)"
      },
      {
        "command": "juvix-mode.openRepl",
        "title": "Open REPL",
        "category": "Juvix"
      },
      {
        "command": "juvix-mode.loadFileRepl",
        "title": "Load current open file in REPL",
        "category": "Juvix",
        "icon": "$(open-preview)"
      },
      {
        "command": "juvix-mode.enableCodeLens",
        "title": "Enable CodeLens",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "command": "juvix-mode.disableCodeLens",
        "title": "Disable CodeLens",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "command": "juvix-mode.clean",
        "title": "Clean: Delete build artifacts",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "command": "juvix-mode.update-dependencies",
        "title": "Update package dependencies",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "command": "juvix-mode.isabelle",
        "title": "Generate Isabelle theory for current file",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "command": "juvix-mode.createOrShowJudoc",
        "title": "HTML preview of current file",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus",
        "icon": "$(book)"
      },
      {
        "command": "juvix-mode.createOrShowJudocOnlySource",
        "title": "HTML Preview [Only Source]",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus",
        "icon": "$(file-code)"
      },
      {
        "command": "juvix-mode.dev-parse",
        "title": "Internal: Parse",
        "category": "Juvix",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "command": "juvix-mode.core-eval",
        "title": "Internal: evaluate current Juvix Core file",
        "category": "Juvix",
        "when": "editorLangId == JuvixCore && editorTextFocus",
        "icon": "$(debug-start)"
      },
      {
        "command": "juvix-mode.core-compile",
        "title": "Internal: compile current Juvix Core file",
        "category": "Juvix",
        "when": "editorLangId == JuvixCore && editorTextFocus",
        "icon": "$(output)"
      },
      {
        "command": "juvix-mode.geb-eval",
        "title": "Internal: evaluate current Geb file",
        "category": "Juvix",
        "when": "editorLangId == JuvixGeb && editorTextFocus",
        "icon": "$(debug-start)"
      },
      {
        "command": "juvix-mode.geb-compile",
        "title": "Internal: compile current Geb file",
        "category": "Juvix",
        "when": "editorLangId == JuvixGeb && editorTextFocus",
        "icon": "$(output)"
      },
      {
        "command": "juvix-mode.geb-check",
        "title": "Internal: typecheck current Geb file",
        "category": "Juvix",
        "when": "editorLangId == JuvixGeb && editorTextFocus",
        "icon": "$(check)"
      }
    ],
    "keybindings": [
      {
        "key": "shift+alt+d",
        "command": "juvix-mode.doctor",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown)"
      },
      {
        "key": "shift+alt+t",
        "command": "juvix-mode.typecheck",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus",
        "icon": "$(debug-start)"
      },
      {
        "key": "shift+alt+c",
        "command": "juvix-mode.compile",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "key": "shift+alt+x",
        "command": "juvix-mode.run",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown) && editorTextFocus"
      },
      {
        "command": "juvix-mode.loadFileRepl",
        "when": "(editorLangId == Juvix || editorLangId == JuvixCore || editorLangId == JuvixGeb)  && editorTextFocus"
      },
      {
        "key": "shift+alt+c",
        "command": "juvix-mode.core-compile",
        "when": "editorLangId == JuvixCore && editorTextFocus"
      },
      {
        "key": "shift+alt+x",
        "command": "juvix-mode.core-eval",
        "when": "editorLangId == JuvixCore && editorTextFocus"
      },
      {
        "key": "shift+alt+x",
        "command": "juvix-mode.geb-eval",
        "when": "editorLangId == JuvixGeb && editorTextFocus"
      },
      {
        "key": "shift+alt+t",
        "command": "juvix-mode.geb-check",
        "when": "editorLangId == JuvixGeb && editorTextFocus",
        "icon": "$(debug-start)"
      },
      {
        "key": "shift+alt+c",
        "command": "juvix-mode.geb-compile",
        "when": "editorLangId == JuvixGeb && editorTextFocus",
        "icon": "$(debug-start)"
      }
    ],
    "submenus": [
      {
        "id": "juvix-submenu",
        "label": "Juvix Commands",
        "when": "(editorLangId == Juvix || editorLangId == JuvixMarkdown)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "juvix-mode:ready && (editorLangId == Juvix || editorLangId == JuvixMarkdown || editorLangId == JuvixCore || editorLangId == JuvixGeb)",
          "command": "juvix-mode.loadFileRepl",
          "group": "navigation@0"
        },
        {
          "when": "juvix-mode:ready && (editorLangId == Juvix || editorLangId == JuvixMarkdown)",
          "command": "juvix-mode.typecheck",
          "group": "navigation@1"
        },
        {
          "when": "juvix-mode:ready && (editorLangId == Juvix || editorLangId == JuvixMarkdown)",
          "command": "juvix-mode.compile",
          "group": "navigation@2"
        },
        {
          "when": "juvix-mode:ready && (editorLangId == Juvix || editorLangId == JuvixMarkdown)",
          "command": "juvix-mode.run",
          "group": "navigation@3"
        },
        {
          "when": "juvix-mode:ready && (editorLangId == Juvix || editorLangId == JuvixMarkdown)",
          "command": "juvix-mode.createOrShowJudoc",
          "group": "navigation@8"
        },
        {
          "when": "juvix-mode:ready && editorLangId == JuvixCore",
          "command": "juvix-mode.core-compile",
          "group": "navigation@2"
        },
        {
          "when": "juvix-mode:ready && editorLangId == JuvixCore",
          "command": "juvix-mode.core-eval",
          "group": "navigation@3"
        },
        {
          "when": "juvix-mode:ready && editorLangId == JuvixGeb",
          "command": "juvix-mode.geb-check",
          "group": "navigation@1"
        },
        {
          "when": "juvix-mode:ready && editorLangId == JuvixGeb",
          "command": "juvix-mode.geb-compile",
          "group": "navigation@2"
        },
        {
          "when": "juvix-mode:ready && editorLangId == JuvixGeb",
          "command": "juvix-mode.geb-eval",
          "group": "navigation@3"
        }
            ],
      "editor/context": [
        {
          "submenu": "juvix-submenu",
          "group": "navigation",
          "when": "juvix-mode:ready && (editorLangId == Juvix || editorLangId == JuvixMarkdown)"
        }
      ],
      "juvix-submenu": [
        {
          "command": "juvix-mode.typecheck",
          "group": "navigation"
        },
        {
          "command": "juvix-mode.compile",
          "group": "navigation"
        },
        {
          "command": "juvix-mode.run",
          "group": "navigation"
        },
        {
          "command": "juvix-mode.doctor",
          "group": "navigation@1.31"
        },
        {
          "command": "juvix-mode.clean",
          "group": "navigation@1.31"
        },
        {
          "command": "juvix-mode.update-dependencies",
          "group": "navigation@1.31"
        },
        {
          "command": "juvix-mode.isabelle",
          "group": "navigation@1.31"
        },
        {
          "command": "juvix-mode.getBinaryVersion",
          "group": "navigation@1.31"
        },
        {
          "command": "juvix-mode.openRepl",
          "group": "navigation@1.31"
        },
        {
          "command": "juvix-mode.loadFileRepl",
          "group": "navigation@1.31"
        }
      ]
    },
    "configuration": {
      "title": "Juvix Mode",
      "properties": {
        "juvix-mode.juvixBinName": {
          "type": "string",
          "default": "juvix",
          "scope": "machine-overridable",
          "description": "Name of the executable of Juvix. (e.g. juvix-v0.6.3)"
        },
        "juvix-mode.juvixBinPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute root path where the Juvix binary is located (e.g. /usr/local/bin/)"
        },
        "juvix-mode.gebBinName": {
          "type": "string",
          "default": "geb.image",
          "scope": "machine-overridable",
          "description": "Name of the executable of geb. (e.g. geb)"
        },
        "juvix-mode.gebBinPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the Geb executable. (e.g. /usr/local/bin/)"
        },
        "juvix-mode.typecheckOn": {
          "type": "string",
          "default": "none",
          "enum": [
            "change",
            "save",
            "none"
          ]
        },
        "juvix-mode.typecheckerExtraArgs": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Extra arguments to pass to the typechecker."
        },
        "juvix-mode.compilationTarget": {
          "type": "string",
          "default": "native",
          "enum": [
            "anoma",
            "cairo",
            "geb",
            "wasi",
            "native",
            "risc0-rust"
          ],
          "scope": "machine-overridable",
          "description": "Specifies the compilation backend to use."
        },
        "juvix-mode.compilationExtraArgs": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Extra arguments to pass to the compiler subcommand. This input goes after the subcommand and before the file name."
        },
        "juvix-mode.compilationOutput": {
          "type": "string",
          "scope": "machine-overridable"
        },
        "juvix-mode.internalBuildDir": {
          "type": "string",
          "default": ".juvix-build",
          "description": "Directory for compiler internal output. An empty string will make the compiler use a temporary directory."
        },
        "juvix-mode.judocDir": {
          "type": "string",
          "default": "html",
          "description": "Directory for HTML output. An empty string will make the compiler use a temporary directory."
        },
        "juvix-mode.globalClean": {
          "type": "boolean",
          "default": false,
